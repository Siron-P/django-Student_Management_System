{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin dashboard — ceniQ</title>
  <meta name="description" content="ceniQ admin dashboard: students, teachers, courses and pending signups at a glance." />
  <meta property="og:title" content="Admin dashboard — ceniQ" />
  <meta property="og:description" content="Manage students, teachers and courses in ceniQ." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="stylesheet" href="{% static 'CSS/styles.css' %}" />
</head>
<body>
  <div class="app-shell">
    <aside class="app-sidebar">
      <a href="{% url 'accounts:index' %}" class="brand">
        <img src="https://placehold.co/80x80/2f6bed/ffffff?text=Q" alt="ceniQ logo" />
        <span class="brand-text">
          <span class="brand-name">ceni<span class="text-gradient-primary">Q</span></span>
          <span class="brand-sub">Student Management System</span>
        </span>
      </a>
      <nav class="app-nav" aria-label="Admin">
        <a href="{% url 'accounts:admin_dashboard' %}" class="app-nav-item active">Dashboard</a>
        <a href="{% url 'accounts:preregister' %}" class="app-nav-item">Preregister</a>
        <a href="#" class="app-nav-item">Students</a>
        <a href="#" class="app-nav-item">Teachers</a>
        <a href="#" class="app-nav-item">Courses</a>
        
      </nav>
    </aside>
 
    <div class="app-main">
      <!-- Topbar -->
      <header class="app-topbar">
        <h1>Admin dashboard</h1>
        <div class="app-user">
          <span class="app-user-avatar">A</span>
          <span>
            <span class="app-user-name" style="display:block;">Anil</span>
            <span class="app-user-role">Admin</span>
            <form method="post" action="{% url 'accounts:logout' %}" class="app-nav-item">
              {% csrf_token %}
              <button type="submit">Log out</button>
            </form>
          </span>
        </div>
      </header>
 
      <main class="app-content">
        <h2 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;color:var(--foreground);margin:0;">
          Welcome back, Anil
        </h2>
 
        <div class="grid sm-cols-2 lg-cols-4 mt-6">
          <div class="stat-card">
            <p class="stat-card-label">Total students</p>
            <p class="stat-card-value">128</p>
          </div>
          <div class="stat-card">
            <p class="stat-card-label">Total teachers</p>
            <p class="stat-card-value">14</p>
          </div>
          <div class="stat-card">
            <p class="stat-card-label">Total courses</p>
            <p class="stat-card-value">9</p>
          </div>
          <div class="stat-card">
            <p class="stat-card-label">Pending signups</p>
            <p class="stat-card-value">23</p>
          </div>
        </div>
 
        <div class="stack sm-row mt-8">
          <a href="{% url 'accounts:preregister' %}" class="btn btn-primary">Preregister student / teacher</a>
          <div class="flex-row-wrap">
            <a href="#" class="pill-link">View students</a>
            <a href="#" class="pill-link">View teachers</a>
            <a href="#" class="pill-link">View courses</a>
          </div>
        </div>
 
        <div class="card p-0 mt-8">
          <div class="card-header">
            <h3>Recent students</h3>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Student ID</th>
                  <th>Name</th>
                  <th>Course</th>
                  <th>Semester</th>
                  <th>Account status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="cell-strong">STU001</td>
                  <td>Ram Thapa</td>
                  <td class="cell-muted">BCA</td>
                  <td class="cell-muted">Sem 4</td>
                  <td><span class="pill pill-warn">Pending</span></td>
                </tr>
                <tr>
                  <td class="cell-strong">STU002</td>
                  <td>Sita Gurung</td>
                  <td class="cell-muted">BSc CSIT</td>
                  <td class="cell-muted">Sem 2</td>
                  <td><span class="pill pill-good">Registered</span></td>
                </tr>
                <tr>
                  <td class="cell-strong">STU003</td>
                  <td>Bikash Shrestha</td>
                  <td class="cell-muted">BIM</td>
                  <td class="cell-muted">Sem 6</td>
                  <td><span class="pill pill-good">Registered</span></td>
                </tr>
                <tr>
                  <td class="cell-strong">STU004</td>
                  <td>Anisha Karki</td>
                  <td class="cell-muted">BCA</td>
                  <td class="cell-muted">Sem 1</td>
                  <td><span class="pill pill-warn">Pending</span></td>
                </tr>
                <tr>
                  <td class="cell-strong">STU005</td>
                  <td>Prakash Adhikari</td>
                  <td class="cell-muted">BSc CSIT</td>
                  <td class="cell-muted">Sem 5</td>
                  <td><span class="pill pill-good">Registered</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
 
  <script src="{% static 'JS/script.js' %}"></script>
</body>
</html>